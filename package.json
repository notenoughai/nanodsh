{
  "name": "nanodsh",
  "version": "0.0.4",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Boot a dsh profile, and nothing else.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notenoughai/nanodsh.git"
  },
  "homepage": "https://github.com/notenoughai/nanodsh#readme",
  "bugs": {
    "url": "https://github.com/notenoughai/nanodsh/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "check": "for file in scripts/*.mjs test/*.mjs; do node --check \"$file\" || exit 1; done && pnpm -r run check",
    "dens": "node scripts/desens.mjs --staged",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm -r run test && node --test test/*.test.mjs",
    "example": "node examples/embed.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@nanodsh/core": "workspace:*"
  }
}
