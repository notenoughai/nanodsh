{
  "name": "@nanodsh/cli",
  "version": "0.0.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Boot a dsh profile, and nothing else.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notenoughai/nanodsh.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/notenoughai/nanodsh#readme",
  "bugs": {
    "url": "https://github.com/notenoughai/nanodsh/issues"
  },
  "type": "module",
  "bin": {
    "nanodsh": "bin/nanodsh.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "README_ZH.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nanodsh/core": "workspace:*",
    "commander": "^15.1.0"
  },
  "scripts": {
    "prepack": "cp ../../README.md ../../README_ZH.md .",
    "postpack": "rm -f README.md README_ZH.md",
    "check": "for file in bin/*.js lib/*.js; do node --check \"$file\" || exit 1; done",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT"
}
